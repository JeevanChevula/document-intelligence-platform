# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Local file storage (documents uploaded during dev) — anchored to repo root
# so it doesn't also match app/storage/, which is real source code
/storage/

# Throwaway files used for manual testing
sample_files/

# Docker volumes data if ever bind-mounted locally
pgdata/
qdrant_storage/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Local virtual environment
.venv/

# IDE
.vscode/
.idea/

# OS
.DS_Store

# Runtime logs from local dev servers
*.log

# Private working log — session-by-session build notes, kept local
PROGRESS.md

# Personal reference material, kept local. Deliberately the specific files rather
# than /docs/, so a future public docs folder isn't silently swallowed.
docs/how-it-works.html
docs/interview-guide.html
